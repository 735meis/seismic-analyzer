# Example Streamlit secrets configuration file
# Copy this file to .streamlit/secrets.toml and fill in your values

# Google Analytics Configuration
# Get your Measurement ID from Google Analytics 4 (format: G-XXXXXXXXXX)
GA_MEASUREMENT_ID = "G-XXXXXXXXXX"

# Get API Secret from: GA Admin → Data Streams → [Your Stream] → Measurement Protocol API secrets
# Required for server-side tracking (recommended to avoid ad blockers)
GA_API_SECRET = "your_api_secret_here"
